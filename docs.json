{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Bonfire Campus",
  "colors": {
    "primary": "#F0442E",
    "light": "#FFF4EE",
    "dark": "#171C24"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/bonfirecampuslogo.png",
    "dark": "/images/bonfirecampuslogo.png",
    "href": "https://bonfirecampus.com"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Campus Site",
      "href": "https://bonfirecampus.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor"
    ]
  },
  "errors": {
    "404": {
      "redirect": false
    }
  },
  "description": "Bonfire Campus Education; Documentation Site",
  "background": {
    "decoration": "gradient"
  },
  "appearance": {
    "strict": true
  },
  "interaction": {
    "drilldown": false
  },
  "footer": {
    "socials": {
      "github": "https://github.com/BonfireCampus",
      "website": "https://github.com/BonfireCampus/bonfirecampus-docs"
    }
  }
}
